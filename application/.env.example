# Node >=24.13.0. Never commit real credentials.
PORT=3000
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# fixture uses synthetic records. Unknown user IDs return an empty account.
RECORDS_MODE=fixture
# live calls Gemini. scripted is an explicit offline test double (fixture mode only).
MODEL_MODE=live
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# For Vertex/Agent Platform, configure the ADK-supported environment and ADC separately.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_JOURNEY_USERS_COLLECTION=cafe-user-journeys
FIRESTORE_WISHLIST_USERS_COLLECTION=cafe-user-wishlists

